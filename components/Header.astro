---
import GithubIcon from '@components/icons/GithubIcon.astro';
import LinkedInIcon from '@components/icons/LinkedInIcon.astro';
import LayoutComponent from '@components/LayoutComponent.astro'
import SettingsButton from '@components/SettingsButton.astro'
import { FaceSlightlySmiling } from '@lucide/astro'
---

<header class="shrink-0 min-w-0 z-4 absolute h-16 w-full top-0 left-0">
  <LayoutComponent class="h-16 flex justify-between items-center gap-2 pixi-hitbox">
    <a href="/" class="flex gap-3 items-center">
      <FaceSlightlySmiling class="size-8" />
      <span>
        <h1 class="font-extrabold">unterberg.dev</h1>
        <h2 class="text-xs font-normal text-base-muted">Richard Unterberg</h2>
      </span>
    </a>
    <div class="flex gap-2 items-center">
      <SettingsButton />
      <a href="https://github.com/richard-unterberg" class="btn btn-sm" aria-label="Visit my Github profile">
        <GithubIcon class="size-4" />
      </a>
      <a href="https://www.linkedin.com/in/richard-unterberg/" class="btn btn-sm" aria-label="Visit my LinkedIn profile">
        <LinkedInIcon class="size-4" />
      </a>
    </div>
  </LayoutComponent>
</header>
