---
import LayoutComponent from '@components/LayoutComponent.astro'
import SettingsButton from '@components/SettingsButton.astro'
import { FaceSlightlySmiling } from '@lucide/astro'
---

<header class="shrink-0 min-w-0 z-4 absolute h-16 w-full top-0 left-0">
  <LayoutComponent class="h-16 flex justify-between items-center gap-2">
    <a href="/" class="flex gap-3 items-center">
      <FaceSlightlySmiling class="size-8" />
      <span>
        <h1 class="font-extrabold">unterberg.dev</h1>
        <h2 class="text-xs font-normal text-base-muted">Richard Unterberg</h2>
      </span>
    </a>
    <SettingsButton />
  </LayoutComponent>
</header>
