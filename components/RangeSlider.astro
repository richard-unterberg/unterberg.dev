---
import ma from '@marmo/astro'

interface Props {
  /** Percentage from 0 to 100, or [minimum, maximum] in multi mode. */
  initialValue?: number | [number, number]
  step?: number
  multi?: boolean
  id?: string
  class?: string
  label?: string
}

const {
  initialValue,
  step = 1,
  multi = false,
  id,
  class: className,
  label = 'Value',
} = Astro.props
const inputStep = Number.isFinite(step) && step > 0 && step <= 100 ? step : 1
const lastStep = Number((Math.floor(100 / inputStep) * inputStep).toFixed(10))
const normalize = (value: number, fallback: number) =>
  Number(
    Math.min(
      lastStep,
      Math.max(
        0,
        Math.round((Number.isFinite(value) ? value : fallback) / inputStep) *
          inputStep,
      ),
    ).toFixed(10),
  )

const singleValue = normalize(
  typeof initialValue === 'number' ? initialValue : 50,
  50,
)
const initialRange = Array.isArray(initialValue) ? initialValue : [0, 100]
let minValue = normalize(initialRange[0], 0)
let maxValue = normalize(initialRange[1], 100)

// Keep the original minimum distance of more than five percentage points.
if (maxValue - minValue <= 5) {
  minValue = 0
  maxValue = lastStep
}

const StyledSlider = ma.div`slider relative w-full h-[7px] cursor-pointer`
const StyledSliderTrack = ma.div`slider__track absolute inset-0 rounded-sm bg-base-300 hover:bg-base-muted`
const StyledSliderRange = ma.div`slider__range absolute h-full rounded-sm bg-warning hover:bg-amber-600`
const StyledThumb = ma.input`thumb absolute`
const inputProps = { type: 'range', min: 0, max: 100, step: inputStep } as const
---

<range-slider id={id} class:list={[className]}>
  <StyledSlider>
    <StyledSliderTrack aria-hidden="true" />
    <StyledSliderRange
      aria-hidden="true"
      style={{
        left: `${multi ? minValue : 0}%`,
        width: `${multi ? maxValue - minValue : singleValue}%`,
      }}
    />
    {multi ? (
      <>
        <StyledThumb
          {...inputProps}
          value={minValue}
          data-thumb="min"
          aria-label={`${label} (minimum)`}
        />
        <StyledThumb
          {...inputProps}
          value={maxValue}
          data-thumb="max"
          aria-label={`${label} (maximum)`}
        />
      </>
    ) : (
      <StyledThumb
        {...inputProps}
        value={singleValue}
        data-thumb="single"
        aria-label={label}
      />
    )}
  </StyledSlider>
</range-slider>

<script>
export interface RangeSliderChangeDetail {
  value: number
  type?: 'min' | 'max'
}

class RangeSlider extends HTMLElement {
  private initialized = false

  connectedCallback() {
    if (this.initialized) return

    const slider = this.querySelector<HTMLDivElement>('.slider')
    const range = this.querySelector<HTMLDivElement>('.slider__range')
    const inputs = [...this.querySelectorAll<HTMLInputElement>('.thumb')]
    const [minInput, maxInput] = inputs
    if (!slider || !range || !minInput)
      throw new Error('RangeSlider markup is incomplete')
    this.initialized = true
    let minValue = minInput.valueAsNumber
    let maxValue = maxInput?.valueAsNumber ?? 100

    const render = () => {
      range.style.left = maxInput ? `${minValue}%` : '0%'
      range.style.width = `${maxInput ? maxValue - minValue : minValue}%`
    }

    const update = (input: HTMLInputElement, value: number) => {
      const previous = input === minInput ? minValue : maxValue
      // Native range inputs clamp and snap values to their configured step.
      input.value = String(value)
      const next = input.valueAsNumber

      if (
        maxInput &&
        (input === minInput ? next >= maxValue - 5 : next <= minValue + 5)
      ) {
        input.value = String(previous)
        return
      }

      if (input === minInput) minValue = next
      else maxValue = next
      render()

      if (next === previous) return

      const detail: RangeSliderChangeDetail = { value: next }
      if (maxInput) detail.type = input === minInput ? 'min' : 'max'

      // Astro props run on the server; subscribe to this event in a browser script.
      this.dispatchEvent(
        new CustomEvent<RangeSliderChangeDetail>('range-change', {
          detail,
          bubbles: true,
        }),
      )
    }

    for (const input of inputs) {
      input.addEventListener('input', () => update(input, input.valueAsNumber))
    }

    slider.addEventListener('click', (event) => {
      if (event.target instanceof HTMLInputElement) return

      const rect = slider.getBoundingClientRect()
      if (!rect.width) return

      const value = Math.max(
        0,
        Math.min(100, ((event.clientX - rect.left) / rect.width) * 100),
      )
      const input =
        maxInput && Math.abs(value - maxValue) <= Math.abs(value - minValue)
          ? maxInput
          : minInput
      input.focus()
      update(input, value)
    })

    render()
  }
}

if (!customElements.get('range-slider'))
  customElements.define('range-slider', RangeSlider)
</script>

<style>
range-slider {
  display: inline-block;
  padding-block: 6px;
  vertical-align: middle;
  width: 100%;
}

range-slider :global(.thumb) {
  appearance: none;
  pointer-events: none;
  top: 50%;
  left: -8px;
  z-index: 1;
  width: calc(100% + 16px);
  height: 24px;
  margin: 0;
  transform: translateY(-50%);
  background: transparent;
}

range-slider :global(.thumb:focus-visible) {
  z-index: 2;
  outline: none;
}

range-slider :global(.thumb::-webkit-slider-runnable-track) {
  height: 7px;
  background: transparent;
}

range-slider :global(.thumb::-moz-range-track) {
  height: 7px;
  background: transparent;
}

range-slider :global(.thumb::-webkit-slider-thumb) {
  appearance: none;
  pointer-events: auto;
  width: 16px;
  height: 16px;
  margin-top: -4.5px;
  border: 2px solid var(--color-base-100);
  border-radius: 50%;
  background: var(--color-warning);
  cursor: grab;
}

range-slider :global(.thumb::-moz-range-thumb) {
  box-sizing: border-box;
  pointer-events: auto;
  width: 16px;
  height: 16px;
  border: 2px solid var(--color-base-100);
  border-radius: 50%;
  background: var(--color-warning);
  cursor: grab;
}

range-slider :global(.thumb:focus-visible::-webkit-slider-thumb) {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

range-slider :global(.thumb:focus-visible::-moz-range-thumb) {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}
</style>
