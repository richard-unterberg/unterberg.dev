---
import ma from '@marmo/astro'
import type { HTMLAttributes } from 'astro/types'

export const layoutComponentSizeMapping = {
  xxs: 'max-w-[480px]',
  xs: 'max-w-[768px]',
  sm: 'max-w-[1000px]',
  md: 'max-w-[1480px]',
  lg: 'max-w-[1800px]',
} as const

export type LayoutSize = keyof typeof layoutComponentSizeMapping

export interface Props extends HTMLAttributes<'div'> {
  $size?: LayoutSize
  $noGrow?: boolean
}

const StyledLayout = ma.div.variants<Props, { $size?: LayoutSize }>({
  base: ({ $noGrow }) => ($noGrow ? '' : 'm-auto w-full px-4'),
  variants: {
    $size: layoutComponentSizeMapping,
  },
  defaultVariants: {
    $size: 'md',
  },
})
---

<StyledLayout {...Astro.props}>
  <slot />
</StyledLayout>
