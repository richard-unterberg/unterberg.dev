---
import Headline, { H2Headline, headlineStyle } from '@components/Headline.astro'
import GithubIcon from '@components/icons/GithubIcon.astro'
import LayoutComponent from '@components/LayoutComponent.astro'
import AppShell from '@layouts/AppShell.astro'
import PixiStage from '@layouts/PixiStage.astro'
import { MoveRight, SquareArrowOutUpRight } from '@lucide/astro'
import { maMerge } from '@marmo/astro'

type Project = {
  id: string
  name: string
  description: string
  technologies: string[]
  developmentFocus: string
  website?: string
  repositoryUrl: string
  notes: string[]
  images?: string[]
  group?: true
}

const response = await fetch(
  'https://raw.githubusercontent.com/richard-unterberg/unterberg.dev/refs/heads/main/public/data/open-source-projects.json',
)
const data: Project[] = await response.json()

const normalEntries = data.filter((item) => !item.group)
const groupedEntries = data.filter((item) => item.group)
---

<AppShell
  title="Discover my open source projects and contributions"
  description="A collection of my open source projects and contributions."
>
  <PixiStage>
    <LayoutComponent class="z-2">
      <div
        class="prose-headings:my-0 pt-16 mb-16 min-h-[50dvh] flex flex-col justify-center"
      >
        <span class="text-primary pixi-hitbox">Contributions</span>
        <Headline variant="ultra" class="inline-block">
          <span class="pixi-hitbox">Open the source</span>
        </Headline>
        <Headline as="p" variant="h4" class="inline-block font-normal!">
          <span class="pixi-hitbox lg:w-3/4 inline-block">
            It often started with a problem. For some of them I found
            shareworthy solutions. Only some of them were selected for this
            overview. Visit my github profile for more open source projects and
            contributions.
          </span>
        </Headline>
      </div>
      <div class="prose-headings:my-0 pixi-hitbox">
        {normalEntries &&
          normalEntries.length > 0 &&
          normalEntries.map((project, i) => (
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-32">
              <div
                class={maMerge(
                  'lg:min-h-90 flex flex-col gap-5',
                  i % 2 === 0 && 'lg:order-last',
                )}
              >
                <H2Headline variant="h3">{project.name}</H2Headline>
                <Headline as="h3" variant="p" class="">
                  {project.developmentFocus}
                </Headline>
                <p class="flex-1">{project.description}</p>

                <div class="flex gap-2 items-center">
                  <a
                    href={project.repositoryUrl}
                    class="btn btn-neutral btn-outline"
                    aria-label="Visit my Github profile"
                    target="_blank"
                    rel="noreferrer"
                  >
                    <GithubIcon class="size-4" /> See Project on Github
                  </a>
                  {project?.website && (
                    <a
                      href={project.website}
                      class="btn btn-neutral"
                      aria-label="See the website or demo of the project"
                      target="_blank"
                      rel="noreferrer"
                    >
                      <SquareArrowOutUpRight class="size-4" /> See demo /
                      official page
                    </a>
                  )}
                </div>
              </div>
              <div class="order-first lg:order-2 relative bg-base-muted-superlight rounded-box border-2 border-base-muted-light overflow-hidden shadow-lg shadow-primary-muted-superlight min-h-[30dvh]">
                {project?.images && project.images.length > 0 && (
                  <a
                    href={project?.website || project?.repositoryUrl || '#'}
                    target="_blank"
                    rel="noreferrer"
                    aria-label="Visit the project repo"
                    class="absolute inset-0 z-4"
                  >
                    <img
                      width={500}
                      height={300}
                      loading={i > 2 ? 'lazy' : 'eager'}
                      src={`/work/${project.images[0]}`}
                      alt={project.name}
                      class="w-full h-full object-cover rounded"
                    />
                  </a>
                )}
                <ul
                  class={maMerge(
                    i % 2
                      ? 'lg:justify-end lg:right-0'
                      : ' justify-start left-0',
                    'absolute bottom-0 not-prose gap-2 flex flex-wrap-reverse lg:w-3/4 xl:w-1/2 z-4 p-3',
                  )}
                >
                  {project.technologies.map((tech) => (
                    <li class="badge badge-primary badge-soft badge-sm py-3">
                      {tech}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        <span class="text-primary mt-20">Open Source</span>
        <H2Headline variant="h1" class="mb-10!">Other Tools</H2Headline>
        {groupedEntries && groupedEntries.length >= 0 && (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 xl:gap-10 mt-12">
            {groupedEntries.map((project) => (
              <div class="min-h-30 flex flex-col gap-5 bg-primary-muted-superlight p-8 xl:p-12 rounded-box border-2 border-primary-muted-light overflow-hidden shadow-lg shadow-primary-muted-superlight">
                <H2Headline variant="h3">{project.name}</H2Headline>
                <ul class="not-prose gap-2 flex flex-wrap justify-start">
                  {project.technologies.map((tech) => (
                    <li class="badge badge-primary badge-soft badge-sm">
                      {tech}
                    </li>
                  ))}
                </ul>
                <Headline as="h3" variant="p" class="min-h-15 w-3/4">
                  {project.developmentFocus}
                </Headline>
                <p class="flex-1">{project.description}</p>
                <a
                  href={project.repositoryUrl}
                  class="btn btn-neutral w-1/2"
                  aria-label="Visit my Github profile"
                  target="_blank"
                  rel="noreferrer"
                >
                  <GithubIcon class="size-4" /> See Project on Github
                </a>
              </div>
            ))}
          </div>
        )}
      </div>
    </LayoutComponent>
    <LayoutComponent class="mt-20 pixi-hitbox">
      <div
        class="border-t border-t-base-muted-light py-20 flex justify-between prose-headings:my-0 gap-14 items-center"
      >
        <div class="flex items-end">
          <div>
            <H2Headline class="leading-16"> More projects? </H2Headline>
            <a
              href="https://github.com/richard-unterberg"
              class={maMerge(headlineStyle.h2, 'text-primary')}
              >See my Github.</a
            >
          </div>
          <MoveRight class="size-12 text-primary ml-3" />
        </div>
        <a
          href="https://github.com/richard-unterberg"
          class="btn btn-xl btn-outline btn-primary"
        >
          <GithubIcon class="size-7" />
          My Github Profile</a
        >
      </div>
    </LayoutComponent>
    <div class="bg-primary-muted-superlight">
      <LayoutComponent
        $size="sm"
        class="prose-headings:my-0 pt-16 mb-16 min-h-[40dvh] flex flex-col justify-center text-center"
      >
        <Headline variant="ultra" class="pixi-hitbox inline-block">
          What about the business?
        </Headline>
        <Headline
          as="p"
          variant="h4"
          class="pixi-hitbox inline-block font-normal!"
        >
          This website represents my personal work and projects. I am only
          partially open to freelance work, collaborations and consulting
          opportunities.
          If you got a crazy idea or interesting projects (Modern Typescript backed Frameworks, Animation driven web products, Prototyping of software architecture) let me know, and we see what we can do.
        </Headline>
        <H2Headline></H2Headline>
        <p></p>
        <p>Interesting job opportunities are welcome at the moment</p>
      </LayoutComponent>
    </div>
    <LayoutComponent class="z-3">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 xl:gap-10">
        <div
          class="prose-headings:my-0 mb-16 min-h-[40dvh] flex flex-col justify-center col-span-2"
        >
          <span class="text-primary">My Embedded Project</span>
          <Headline variant="ultra" class="pixi-hitbox inline-block">
            Soup Station
          </Headline>
          <Headline
            as="p"
            variant="h4"
            class="pixi-hitbox inline-block font-normal! w-3/4"
          >
            The idea slowly becomes reality: An embedded audio workstation,
            which can play, record and edit multiple audio clips and sequence
            between them. Including a heavy DSP unit for beautiful effect chains<br>
          </Headline>
        </div>
        <img
          width={500}
          height={300}
          loading="lazy"
          src={`/work/soup/soup-ai-model.png`}
          alt="Soup Station Model"
          class="w-full h-auto rounded"
        >
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3">
        <div class="col-span-2">
          <div class="grid grid-cols-2 relative">
            <p>
              Some text about the project. Lorem ipsum dolor sit amet,
              consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut
              labore et dolore magna aliqua. Ut enim ad minim veniam, quis
              nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo
              consequat.
            </p>

            <p>
              Duis aute irure dolor in reprehenderit in voluptate velit esse
              cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat
              cupidatat non proident, sunt in culpa qui officia deserunt mollit
              anim id est laborum.
            </p>
            <img
              width={500}
              height={300}
              loading="lazy"
              src={`/work/soup/side.jpg`}
              alt="Soup Station Model"
              class="w-full h-full rounded object-cover"
            >
            <img
              width={500}
              height={300}
              loading="lazy"
              src={`/work/soup/top.jpg`}
              alt="Soup Station Model"
              class="w-full h-full rounded object-cover"
            >
          </div>
        </div>
      </div>
    </LayoutComponent>
    
  </PixiStage>
</AppShell>
