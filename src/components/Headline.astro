---
import ma from '@marmo/astro'
import type { HTMLAttributes } from 'astro/types'

type HeadlineElement = 'ultra' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p'

export const headlineStyle = {
  ultra: 'text-6xl xl:text-7xl font-black',
  h1: 'text-5xl md:lg:text-6xl lg:text-7xl font-black',
  h2: 'text-4xl md:text-5xl font-bold text-light',
  h3: 'text-3xl text-gray font-bold',
  h4: 'text-2xl text-light font-bold',
  h5: 'text-xl font-medium text-gray',
  h6: 'text-lg font-medium text-light',
  p: 'text-base',
}

interface Props extends HTMLAttributes<'h1'> {
  as?: HeadlineElement
  variant?: HeadlineElement
}

export const createHeadlineComponent = (
  level: Exclude<HeadlineElement, 'p'>,
) => {
  return ma.h1
    .logic<Props & { $_as?: HeadlineElement }>(
      ({ as = level, variant = level }) => ({ $_as: as, variant }),
    )
    .variants<object, { as?: HeadlineElement; variant?: HeadlineElement }>({
      variants: {
        // Register `as` so Marmo consumes it instead of rendering an HTML attribute.
        as: {},
        variant: headlineStyle
      },
    })
}

export const H1Headline = createHeadlineComponent('h1')
export const H2Headline = createHeadlineComponent('h2')
export const H3Headline = createHeadlineComponent('h3')
export const H4Headline = createHeadlineComponent('h4')
export const H5Headline = createHeadlineComponent('h5')
export const H6Headline = createHeadlineComponent('h6')

const { as = 'h1', variant = as, ...attributes } = Astro.props
---

<H1Headline as={as} variant={variant} {...attributes}>
  <slot />
</H1Headline>
