---
import Headline, { H2Headline } from '@components/Headline.astro'
import LayoutComponent from '@components/LayoutComponent.astro'
import AppShell from '@layouts/AppShell.astro'
import PixiStage from '@layouts/PixiStage.astro'
import { maMerge } from '@marmo/astro'

type Project = {
  id: string
  name: string
  description: string
  technologies: string[]
  developmentFocus: string
  additionalLinks: string[]
  repositoryUrl: string
  notes: string[]
  images?: string[]
}

const response = await fetch(
  'https://raw.githubusercontent.com/richard-unterberg/unterberg.dev/refs/heads/main/public/data/open-source-projects.json',
)
const data: Project[] = await response.json()
---

<AppShell title="Discover my open source projects and contributions" description="A collection of my open source projects and contributions.">
  <PixiStage>
    <LayoutComponent class="z-2">
      <div class="prose-headings:my-0 pt-16 mb-16 min-h-[40dvh] flex flex-col justify-center">
        <Headline variant="ultra" class="pixi-hitbox inline-block"
          >Open Source</Headline
        >
        <Headline
          as="p"
          variant="h4"
          class="pixi-hitbox inline-block font-normal!"
        >
          Only selected projects sitting here. Visit my github profile
          for more open source projects and contributions.
        </Headline>
      </div>
      <div class="prose-headings:my-0 pixi-hitbox">
        {data &&
          data.length > 0 &&
          data.map((project, i) => (
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-16">
              <div
                class={maMerge(
                  'min-h-90 flex flex-col gap-5',
                  i % 2 === 0 && 'lg:order-last',
                )}
              >
                <H2Headline variant="h3">{project.name}</H2Headline>
                <Headline as="h3" variant="p" class="">
                  {project.developmentFocus}
                </Headline>
                <p class="flex-1">{project.description}</p>
                <ul class="not-prose gap-2 flex flex-wrap justify-start w-3/4">
                  {project.technologies.map((tech) => (
                    <li class="badge badge-primary badge-soft badge-sm">
                      {tech}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="bg-base-muted-superlight rounded-box border-2 border-base-muted-light overflow-hidden shadow-lg shadow-base-200">
                {project?.images && project.images.length > 0 && (
                  <img
                    width={500}
                    height={300}
                    loading={i > 2 ? "lazy" : "eager"}
                    src={`/work/${project.images[0]}`}
                    alt={project.name}
                    class="w-full h-full object-cover rounded"
                  />
                )}
              </div>
            </div>
          ))}
        <Headline variant="ultra" class="pixi-hitbox inline-block">
          Aside
        </Headline>
        <ul>
          <li>soup-station</li>
          <li>music: return false</li>
        </ul>
      </div>
    </LayoutComponent>
    <div class="bg-primary-muted-superlight">
      <LayoutComponent>
        <Headline variant="ultra" class="pixi-hitbox inline-block">
          What about the business?
        </Headline>
        <p>
          This website represents my personal work and projects. I am only
          partially open to freelance work, collaborations, and consulting
          opportunities. We can talk about in person. I can fix your problem.
        </p>
        </LayoutComponent>
      </div>
  </PixiStage>
</AppShell>
