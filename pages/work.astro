---
import LayoutComponent from '@components/LayoutComponent.astro';
import AppShell from '@layouts/AppShell.astro'
import PixiStage from '@layouts/PixiStage.astro'

const response = await fetch("/open-source-projects.json");
const data = await response.json();
const projects = data.results[0];
---

<AppShell>
  <PixiStage>
    <LayoutComponent class="pixi-hitbox">
    <ul>
      <li>marmo</li>
      <li>nivel</li>
      <li>vike's startpage</li>
      <li>vite-beasties-output</li>
      <li>astro-maplibre</li>
      <li>leaflet-nextjs-ts-starter</li>
      <li>maplibre-vike</li>
      <li>maplibre-nextjs-ts-starter</li>
      <li>convert-to-arrow</li>
    </ul>

    <ul>
      <li>demon-designs.de</li>
      <li>diefabrik.de</li>
      <li>unterberg.dev</li>
    </ul>

    <ul>
      <li>soup-station</li>
      <li>music: return false</li>
    </ul>
    </LayoutComponent>
  </PixiStage>
</AppShell>
